{
  "name": "medconnect",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "dev": "turbo dev",
    "dev:all": "node scripts/dev-all.mjs",
    "dev:infra": "docker compose up -d postgres redis pgbouncer",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "format": "turbo format",
    "db:migrate": "pnpm --filter @medconnect/api prisma:migrate",
    "db:seed": "pnpm --filter @medconnect/api prisma:seed",
    "mobile": "pnpm --filter @medconnect/mobile start",
    "api": "pnpm --filter @medconnect/api start:dev"
  },
  "devDependencies": {
    "gitleaks": "1.0.0",
    "turbo": "2.10.12",
    "typescript": "~6.0.3"
  }
}
