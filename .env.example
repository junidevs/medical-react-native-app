# Copy to .env for root/dev tooling, apps/api/.env for backend, and apps/mobile/.env for Expo public variables.
# Never commit real secrets. The repo includes gitleaks CI/pre-commit guidance in README.

NODE_ENV=development
AUTH_MODE=mock

# Mobile public config (safe to expose in app bundle)
EXPO_PUBLIC_AUTH_MODE=mock
EXPO_PUBLIC_API_URL=http://localhost:4000
EXPO_PUBLIC_ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
EXPO_PUBLIC_ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
EXPO_PUBLIC_ENTRA_API_SCOPE=api://00000000-0000-0000-0000-000000000000/access_as_user
EXPO_PUBLIC_PORTAL_URL=https://portal.localhost
EXPO_PUBLIC_SENTRY_DSN=

# Mobile feature flags
EXPO_PUBLIC_FEATURE_MOCK_LOGIN=true
EXPO_PUBLIC_FEATURE_PORTAL_WEBVIEW=true
EXPO_PUBLIC_FEATURE_PORTAL_QR_SCANNER=true
EXPO_PUBLIC_FEATURE_PUSH_NOTIFICATIONS=true
EXPO_PUBLIC_FEATURE_BIOMETRIC_LOCK=true
EXPO_PUBLIC_FEATURE_DEVICE_INTEGRITY=true
EXPO_PUBLIC_FEATURE_WIDGETS=true
# Enable Lottie animations / glass blur (require a build with lottie-react-native / expo-blur):
# EXPO_PUBLIC_LOTTIE=1
# EXPO_PUBLIC_BLUR=1

# Expo/EAS public identifiers (not secrets, but configurable per tenant/environment)
MEDCONNECT_APP_NAME=MedConnect
MEDCONNECT_APP_SLUG=medconnect
MEDCONNECT_APP_SCHEME=medconnect
MEDCONNECT_APP_VERSION=1.0.0
MEDCONNECT_IOS_BUNDLE_IDENTIFIER=com.medconnect.patient
MEDCONNECT_ANDROID_PACKAGE=com.medconnect.patient
MEDCONNECT_APPLE_TEAM_ID=TEAMID1234
MEDCONNECT_IOS_APP_GROUP=group.com.medconnect.patient
MEDCONNECT_EXPO_OWNER=ddevcat
MEDCONNECT_EAS_PROJECT_ID=00000000-0000-0000-0000-000000000000
MEDCONNECT_UPDATES_URL=https://u.expo.dev/00000000-0000-0000-0000-000000000000

# EAS Submit / store credentials (examples only; real files are gitignored)
MEDCONNECT_ASC_APP_ID=0000000000
GOOGLE_PLAY_SERVICE_ACCOUNT_KEY_PATH=./google-play-service-account.json

# API config
PORT=4000
DATABASE_URL=postgresql://medconnect:medconnect@localhost:6432/medconnect?schema=public
DIRECT_DATABASE_URL=postgresql://medconnect:medconnect@localhost:5432/medconnect?schema=public
REDIS_URL=redis://localhost:6379
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
ENTRA_ISSUER=https://login.microsoftonline.com/00000000-0000-0000-0000-000000000000/v2.0
ENTRA_AUDIENCE=api://00000000-0000-0000-0000-000000000000
ENTRA_JWKS_URI=https://login.microsoftonline.com/00000000-0000-0000-0000-000000000000/discovery/v2.0/keys
MOCK_ISSUER=http://localhost:4000/mock-identity
MOCK_AUDIENCE=api://medconnect-api
MOCK_JWKS_URI=http://localhost:4000/mock-identity/jwks
AZURE_NOTIFICATION_HUB_CONNECTION_STRING=Endpoint=sb://example.servicebus.windows.net/;SharedAccessKeyName=DefaultFullSharedAccessSignature;SharedAccessKey=PLACEHOLDER
AZURE_NOTIFICATION_HUB_NAME=medconnect-dev
FEATURE_MOCK_IDENTITY=true
FEATURE_PORTAL_PAIRING=true
SENTRY_DSN=

