{
  "name": "@medconnect/mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build": "expo export",
    "lint": "expo lint",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "format": "prettier --check \"app/**/*.{ts,tsx}\" \"src/**/*.{ts,tsx}\"",
    "repack:start": "react-native webpack-start",
    "repack:bundle:android": "react-native webpack-bundle --platform android --dev false --entry-file index.repack.js --bundle-output dist/index.android.bundle --assets-dest dist/android",
    "repack:bundle:ios": "react-native webpack-bundle --platform ios --dev false --entry-file index.repack.js --bundle-output dist/index.ios.bundle --assets-dest dist/ios"
  },
  "dependencies": {
    "@expo/ui": "~57.0.15",
    "@expo/vector-icons": "^15.1.1",
    "@medconnect/mf-contracts": "workspace:*",
    "@module-federation/enhanced": "2.9.0",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@medconnect/shared": "workspace:*",
    "@react-native-community/netinfo": "12.0.1",
    "@sentry/react-native": "7.11.0",
    "@shopify/react-native-skia": "2.6.2",
    "@tanstack/react-query": "5.102.8",
    "expo": "~57.0.19",
    "expo-auth-session": "~57.0.11",
    "expo-blur": "~57.0.2",
    "expo-camera": "~57.0.4",
    "expo-constants": "~57.0.17",
    "expo-crypto": "~57.0.2",
    "expo-dev-client": "~57.0.18",
    "expo-device": "~57.0.1",
    "expo-haptics": "~57.0.2",
    "expo-linking": "~57.0.9",
    "expo-local-authentication": "~57.0.2",
    "expo-notifications": "~57.0.16",
    "expo-router": "~57.0.18",
    "expo-secure-store": "~57.0.3",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.3",
    "expo-updates": "~57.0.21",
    "expo-web-browser": "~57.0.2",
    "expo-widgets": "~57.0.16",
    "jail-monkey": "3.0.0",
    "lottie-react-native": "~7.3.8",
    "msw": "2.15.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-mmkv": "^4.3.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1",
    "zod": "4.5.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@callstack/repack": "5.3.0",
    "@react-native-community/cli": "^20.2.0",
    "@types/react": "~19.2.2",
    "babel-loader": "^9.2.1",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "terser-webpack-plugin": "^5.6.1",
    "typescript": "~6.0.3",
    "vitest": "4.1.11",
    "webpack": "^5.110.3"
  }
}
